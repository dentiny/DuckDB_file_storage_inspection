{
  "name": "duckdb-file-storage-inspection",
  "version": "0.1.0",
  "private": true,
  "description": "See how a DuckDB database file is laid out, block by block",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "verify": "npm run lint && npm run check && npm run build",
    "start": "node scripts/start.ts",
    "sample": "./scripts/make-sample.sh",
    "examples": "node scripts/make-examples.ts",
    "screenshots": "npm run build && node scripts/screenshots.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.19.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1"
  }
}
